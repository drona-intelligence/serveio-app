generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

model Order {
  id        String   @id @default(uuid())
  userId    Int

  status    OrderStatus @default(PENDING)
  totalAmount Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  itemId    String
  name      String
  price     Float
  quantity  Int

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([itemId])
}
