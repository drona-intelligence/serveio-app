# Serveio Platform Environment Configuration
# This file contains all environment variables for the microservices

# Common
JWT_ACCESS_SECRET=your-access-secret-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production

# PostgreSQL - Users Service
POSTGRES_DB=users_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# PostgreSQL - Restaurant Service
RESTAURANT_DB=restaurant_db
RESTAURANT_USER=restaurant_user
RESTAURANT_PASSWORD=restaurant_password

# PostgreSQL - Cart Service
CART_DB=cart_db
CART_USER=cart_user
CART_PASSWORD=cart_password

# PostgreSQL - Order Service
ORDER_DB=order_db
ORDER_USER=order_user
ORDER_PASSWORD=order_password

# Redis (shared across services)
REDIS_HOST=redis
REDIS_PORT=6379

# Service Ports
PORT=3000
RESTAURANT_PORT=3001
CART_PORT=3002
ORDER_PORT=3003
NOTIFICATION_PORT=3004

# Notification Service
QUEUE_NAME=order-events

# Docker Hub Username (for building images)
DOCKERHUB_USERNAME=yourusername
