{
  "name": "notification-service",
  "version": "1.0.0",
  "description": "Notification service for Serveio - consumes order events and sends notifications",
  "main": "dist/src/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/config/worker.js"
  },
  "keywords": [
    "notification",
    "bullmq",
    "redis",
    "order-events"
  ],
  "author": "Serveio",
  "license": "MIT",
  "dependencies": {
    "express": "^5.0.0",
    "bullmq": "^5.14.1",
    "ioredis": "^5.3.2",
    "dotenv": "^16.3.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  }
}
